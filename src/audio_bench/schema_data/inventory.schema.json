{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.audio-bench.invalid/inventory/0.1",
  "title": "Artifact inventory for a sealed attempt (closed over payload files)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "files",
    "expected_artifact_set_id",
    "actual_artifact_set_id",
    "expected_case_metric_count",
    "actual_case_metric_count",
    "missing_ids",
    "extra_ids",
    "complete"
  ],
  "properties": {
    "schema_id": { "const": "audio-bench/inventory/0.1" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "media_type", "bytes", "sha256", "classification", "parent_digests"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
          },
          "media_type": {
            "enum": [
              "application/json",
              "application/jsonl",
              "audio/wav",
              "text/plain",
              "image/png"
            ]
          },
          "bytes": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/uint64_string" },
          "sha256": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
          "classification": {
            "enum": ["observation", "output", "summary", "source_map", "attestation", "preview"]
          },
          "parent_digests": {
            "type": "array",
            "items": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" }
          }
        }
      }
    },
    "expected_artifact_set_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
    "actual_artifact_set_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
    "expected_case_metric_count": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/uint64_string" },
    "actual_case_metric_count": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/uint64_string" },
    "missing_ids": {
      "type": "array",
      "items": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/display_text" }
    },
    "extra_ids": {
      "type": "array",
      "items": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/display_text" }
    },
    "complete": { "type": "boolean" }
  }
}
