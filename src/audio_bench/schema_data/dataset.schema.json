{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.audio-bench.invalid/dataset/0.1",
  "title": "Dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "identity_algorithm",
    "dataset_id",
    "source",
    "file_shards",
    "case_inventory_digest",
    "decode_recipe",
    "rights",
    "training_exposure"
  ],
  "properties": {
    "schema_id": { "const": "audio-bench/dataset/0.1" },
    "identity_algorithm": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/identity_algorithm" },
    "dataset_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
    "label": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/display_text" },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "revision", "archive_sha256", "archive_bytes"],
          "properties": {
            "kind": { "const": "https_archive" },
            "url": { "type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2048 },
            "revision": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/display_text" },
            "archive_sha256": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
            "archive_bytes": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/uint64_string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "generator_digest", "generator_recipe"],
          "properties": {
            "kind": { "const": "generated" },
            "generator_digest": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
            "generator_recipe": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/display_text" }
          }
        }
      ]
    },
    "file_shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shard_digest", "records", "bytes"],
        "properties": {
          "shard_digest": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
          "records": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/uint64_string" },
          "bytes": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/uint64_string" }
        }
      }
    },
    "case_inventory_digest": {
      "description": "Digest of the sorted case entries with their dataset_id field omitted. Dataset identity is taken over this digest instead of the shard bytes, which would otherwise embed the dataset_id and create a hash cycle.",
      "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest"
    },
    "decode_recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "container", "dtype", "channel_policy"],
      "properties": {
        "implementation": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/display_text" },
        "version": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/display_text" },
        "container": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/display_text" },
        "dtype": { "enum": ["float32"] },
        "channel_policy": { "enum": ["reject_non_mono", "downmix_forbidden"] }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acquisition", "evaluation", "redistribution", "public_playback"],
      "properties": {
        "acquisition": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/rights_scope" },
        "evaluation": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/rights_scope" },
        "redistribution": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/rights_scope" },
        "public_playback": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/rights_scope" }
      }
    },
    "training_exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": { "enum": ["known", "declared", "unknown"] },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/display_text" }
        }
      }
    }
  }
}
