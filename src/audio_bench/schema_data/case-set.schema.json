{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.audio-bench.invalid/case-set/0.1",
  "title": "Frozen case set (exact case IDs and content digests used by a cohort)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "identity_algorithm", "case_set_id", "dataset_id", "task", "cases", "protocol_digest"],
  "properties": {
    "schema_id": { "const": "audio-bench/case-set/0.1" },
    "identity_algorithm": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/identity_algorithm" },
    "case_set_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
    "dataset_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
    "task": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/bounded_id" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "noisy_file_digest", "clean_file_digest", "sample_count", "speaker_id", "source_partition"],
        "properties": {
          "case_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/bounded_id" },
          "noisy_file_digest": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
          "clean_file_digest": {
            "oneOf": [
              { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
              { "type": "null" }
            ]
          },
          "sample_count": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/uint64_string" },
          "speaker_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/bounded_id" },
          "source_partition": { "enum": ["train", "dev", "test", "synthetic"] }
        }
      }
    },
    "selection_script_digest": {
      "oneOf": [
        { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "protocol_digest": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" }
  }
}
