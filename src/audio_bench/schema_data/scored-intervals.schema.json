{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.audio-bench.invalid/scored-intervals/0.1",
  "title": "Frozen scored interval map: one interval per case, shared by clean/raw/all candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "identity_algorithm",
    "scored_interval_set_id",
    "case_set_id",
    "entries",
    "protocol_digest"
  ],
  "properties": {
    "schema_id": { "const": "audio-bench/scored-intervals/0.1" },
    "identity_algorithm": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/identity_algorithm" },
    "scored_interval_set_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
    "case_set_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "start_sample", "end_sample", "edge_exclusion_start", "edge_exclusion_end"],
        "properties": {
          "case_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/bounded_id" },
          "start_sample": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/uint64_string" },
          "end_sample": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/uint64_string" },
          "edge_exclusion_start": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/uint64_string" },
          "edge_exclusion_end": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/uint64_string" }
        }
      }
    },
    "protocol_digest": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" }
  }
}
