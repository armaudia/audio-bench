{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audio-bench/submitter-result/0.1",
  "title": "Submitter-owned benchmark result record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "submission_id", "result_id", "display_name", "task", "runner_mode", "result_status", "provider_id", "suite_id", "dataset_id", "model_digest", "source", "metrics", "baseline", "evidence"],
  "properties": {
    "schema_id": {"const": "audio-bench/submitter-result/0.1"},
    "submission_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
    "result_id": {"type": "string", "pattern": "^[a-zA-Z0-9._:-]{8,180}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "task": {"const": "noise-cancellation"},
    "runner_mode": {"const": "submitter-owned"},
    "result_status": {"const": "Submitter-run · not independently verified"},
    "provider_id": {"type": "string", "pattern": "^[a-zA-Z0-9._-]{1,120}$"},
    "suite_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,80}$"},
    "dataset_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dataset_label": {"type": "string", "minLength": 1, "maxLength": 180},
    "case_count": {"type": "integer", "minimum": 1},
    "model_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["visibility", "revision", "repository_identity_sha256"],
      "properties": {
        "visibility": {"const": "private"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "repository_identity_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "metrics": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metric_id", "label", "unit", "median", "finite_count"],
        "properties": {
          "metric_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 100},
          "unit": {"enum": ["dB", "ratio", "count", "index", "none", "ms"]},
          "median": {"type": "number"},
          "mean": {"type": "number"},
          "median_interval_95": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "finite_count": {"type": "integer", "minimum": 1},
          "normalized_median": {"type": ["number", "null"]},
          "normalized_unit": {"enum": ["ms", "dB", "ratio", "count", "index", "none"]}
        }
      }
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "run_id", "metrics"],
      "properties": {
        "provider_id": {"type": "string", "pattern": "^[a-zA-Z0-9._-]{1,120}$"},
        "run_id": {"type": "string", "minLength": 8, "maxLength": 180},
        "metrics": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["metric_id", "median", "unit"], "properties": {"metric_id": {"type": "string"}, "median": {"type": "number"}, "unit": {"type": "string"}}}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["harness_revision", "harness_digest", "dataset_manifest_digest", "runner_fingerprint", "reference_raw_latency_ms", "candidate_raw_latency_ms", "reference_baseline_latency_ms"],
      "properties": {
        "harness_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "harness_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "dataset_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "runner_fingerprint": {"type": "string", "minLength": 1, "maxLength": 300},
        "reference_raw_latency_ms": {"type": "number", "exclusiveMinimum": 0},
        "candidate_raw_latency_ms": {"type": "number", "exclusiveMinimum": 0},
        "reference_baseline_latency_ms": {"type": "number", "exclusiveMinimum": 0},
        "workflow_attestation_url": {"type": ["string", "null"], "pattern": "^https://[^\\s]+$"}
      }
    }
  }
}
