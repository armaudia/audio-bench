{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audio-bench/paired-corpus-provenance/0.1",
  "title": "Pinned paired corpus cohort provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "subset_id", "purpose", "source", "source_components", "partition", "counts", "archives", "case_manifest_sha256", "limitations"],
  "properties": {
    "schema_id": {"const": "audio-bench/paired-corpus-provenance/0.1"},
    "subset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,80}$"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_title", "publisher", "doi", "record_url", "downloaded_at", "license", "license_url", "attribution"],
      "properties": {
        "dataset_title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "doi": {"type": "string", "minLength": 1},
        "record_url": {"type": "string", "pattern": "^https://[^\\s]+$"},
        "downloaded_at": {"type": "string", "format": "date"},
        "license": {"type": "string", "minLength": 1},
        "license_url": {"type": "string", "pattern": "^https://[^\\s]+$"},
        "attribution": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "source_components": {"type": "object", "minProperties": 1},
    "partition": {"type": "string", "minLength": 1},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["paired_utterances", "distinct_speakers", "channels", "sample_rate_hz", "sample_width_bits", "minimum_samples", "maximum_samples"],
      "properties": {
        "paired_utterances": {"type": "integer", "minimum": 1},
        "distinct_speakers": {"type": "integer", "minimum": 1},
        "channels": {"const": 1},
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "sample_width_bits": {"type": "integer", "minimum": 1},
        "minimum_samples": {"type": "integer", "minimum": 1},
        "maximum_samples": {"type": "integer", "minimum": 1}
      }
    },
    "archives": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "filename", "url", "bytes", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
          "filename": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.zip$"},
          "url": {"type": "string", "pattern": "^https://datashare\\.ed\\.ac\\.uk/[^\\s]+$"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "case_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
