{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.audio-bench.invalid/defs/0.1",
  "title": "audio-bench shared definitions v0.1",
  "description": "Shared bounded definitions. Code-level invariants (digest recomputation, sorted sets, uint64/int64 bounds, interval arithmetic, referential closure) are enforced separately; JSON Schema does not replace them.",
  "$defs": {
    "schema_id": {
      "type": "string",
      "pattern": "^audio-bench/[a-z0-9-]+/[0-9]+\\.[0-9]+$"
    },
    "bounded_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identity_algorithm": {
      "const": "jcs-sha256-v1"
    },
    "uint64_string": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "int64_string": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "decimal_string": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "safe_integer": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "display_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "execution_status": {
      "enum": ["passed", "failed", "blocked", "invalid", "not_applicable", "not_run"]
    },
    "reason": {
      "enum": [
        "asset_unavailable",
        "rights_unknown",
        "incompatible_contract",
        "backend_failure",
        "needs_reset",
        "timing_mapping_unverified",
        "incomplete_output",
        "deadline_miss",
        "harness_late",
        "nonfinite_output",
        "metric_undefined",
        "invalid_bundle",
        "cancelled",
        "unsupported_capability",
        "zero_reference_energy",
        "perfect_reconstruction",
        "zero_output_energy",
        "zero_input_energy",
        "insufficient_active_speech",
        "invalid_input",
        "missing_dependency",
        "resource_exhausted",
        "not_implemented"
      ]
    },
    "direction": {
      "enum": ["higher", "lower", "diagnostic"]
    },
    "rights_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "evidence_ref", "reviewer", "reviewed_at"],
      "properties": {
        "decision": { "enum": ["allowed", "denied", "unknown"] },
        "evidence_ref": { "$ref": "#/$defs/display_text" },
        "reviewer": { "$ref": "#/$defs/display_text" },
        "reviewed_at": { "$ref": "#/$defs/utc" }
      }
    },
    "value_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_sample", "end_sample", "sample_rate_hz"],
      "properties": {
        "start_sample": { "$ref": "#/$defs/int64_string" },
        "end_sample": { "$ref": "#/$defs/int64_string" },
        "sample_rate_hz": { "const": 16000 }
      }
    }
  }
}
