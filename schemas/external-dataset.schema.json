{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audio-bench/external-dataset/0.1",
  "title": "Externally stored dataset asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "dataset_id", "version", "license", "allowed_hosts", "files"],
  "properties": {
    "schema_id": {"const": "audio-bench/external-dataset/0.1"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,80}$"},
    "version": {"type": "string", "pattern": "^[a-zA-Z0-9._-]{1,80}$"},
    "license": {"type": "object", "additionalProperties": false, "required": ["spdx_id", "source_url", "attribution"], "properties": {"spdx_id": {"type": "string", "minLength": 1}, "source_url": {"type": "string", "pattern": "^https://[^\\s]+$"}, "attribution": {"type": "string", "minLength": 1, "maxLength": 1000}}},
    "allowed_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9.-]+$"}},
    "files": {"type": "array", "minItems": 1, "maxItems": 20000, "items": {"type": "object", "additionalProperties": false, "required": ["path", "url", "sha256", "bytes", "case_id", "role"], "properties": {"path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}, "url": {"type": "string", "pattern": "^https://[^\\s]+$"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 2147483648}, "case_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,120}$"}, "role": {"enum": ["clean", "noisy", "metadata"]}}}}
  }
}
