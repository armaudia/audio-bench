{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.audio-bench.invalid/case/0.1",
  "title": "Case record (one JSONL entry inside a dataset file shard)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "case_id",
    "dataset_id",
    "source_path",
    "noisy_file_digest",
    "clean_file_digest",
    "sample_rate_hz",
    "channels",
    "sample_count",
    "speaker_id",
    "session_id",
    "task",
    "annotations_digest",
    "source_partition",
    "allowed_use"
  ],
  "properties": {
    "schema_id": { "const": "audio-bench/case/0.1" },
    "case_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/bounded_id" },
    "dataset_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
    "source_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^/][^\\u0000]*$",
      "description": "Path relative to the verified source archive root; absolute paths and '..' are rejected in code."
    },
    "noisy_file_digest": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
    "clean_file_digest": {
      "oneOf": [
        { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "sample_rate_hz": { "const": 16000 },
    "channels": { "const": 1 },
    "sample_count": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/uint64_string" },
    "speaker_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/bounded_id" },
    "session_id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/bounded_id" },
    "task": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/bounded_id" },
    "annotations_digest": {
      "oneOf": [
        { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "source_partition": { "enum": ["train", "dev", "test", "synthetic"] },
    "allowed_use": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["acquisition", "evaluation", "redistribution", "public_playback"] }
    }
  }
}
