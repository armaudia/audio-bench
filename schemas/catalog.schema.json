{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.audio-bench.invalid/catalog/0.1",
  "title": "Closed public catalog entries (catalog metadata is not qualification)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "entries"],
  "properties": {
    "schema_id": { "const": "audio-bench/catalog/0.1" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "type", "display_name", "upstream_url", "upstream_revision",
          "attribution", "license", "rights_refs", "maintenance_owner",
          "maintenance_status", "source_availability", "vendor_endorsement",
          "contract_versions", "platforms", "tasks", "descriptor_digest",
          "acquisition_instructions", "attempt_refs", "status", "blocked_reason",
          "model_id", "dependencies"
        ],
        "properties": {
          "id": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/bounded_id" },
          "type": { "enum": ["provider", "model", "implementation", "engine", "pipeline", "host"] },
          "display_name": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/display_text" },
          "upstream_url": { "oneOf": [{ "type": "string", "pattern": "^https://[^\\s]+$" }, { "type": "null" }] },
          "upstream_revision": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "attribution": { "type": "array", "items": { "type": "string" } },
          "license": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "rights_refs": { "type": "array", "items": { "type": "string" } },
          "maintenance_owner": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
          "maintenance_status": { "enum": ["active", "unmaintained", "unknown", "not_applicable"] },
          "source_availability": { "enum": ["public", "private", "unavailable", "unknown", "control_only"] },
          "vendor_endorsement": { "enum": ["evidenced", "not_evidenced", "unknown", "not_applicable"] },
          "contract_versions": { "type": "array", "items": { "type": "string" } },
          "platforms": { "type": "array", "items": { "type": "string" } },
          "tasks": { "type": "array", "items": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/bounded_id" } },
          "descriptor_digest": {
            "oneOf": [
              { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/digest" },
              { "type": "null" }
            ]
          },
          "acquisition_instructions": { "type": "string", "maxLength": 4000 },
          "attempt_refs": { "type": "array", "items": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/bounded_id" } },
          "status": { "enum": ["available", "blocked", "deprecated"] },
          "blocked_reason": {
            "oneOf": [
              { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/display_text" },
              { "type": "null" }
            ]
          },
          "model_id": {
            "oneOf": [
              { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/bounded_id" },
              { "type": "null" }
            ]
          },
          "dependencies": { "type": "array", "items": { "$ref": "https://schemas.audio-bench.invalid/defs/0.1#/$defs/bounded_id" } }
        }
      }
    }
  }
}
